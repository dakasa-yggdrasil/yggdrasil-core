{
  "openapi": "3.0.3",
  "info": {
    "title": "Yggdrasil Core API",
    "version": "2.1.0",
    "description": "Synchronous HTTP surface of yggdrasil-core. Manifest CRUD, integration instances, workflow runs, secrets, GitHub webhook. See docs/api-reference/openapi.md for the narrative companion.",
    "license": {"name": "MIT"}
  },
  "servers": [
    {"url": "http://localhost:9080", "description": "Local quickstart (port-forward)"},
    {"url": "https://yggdrasil.example.com", "description": "Adopter-hosted instance"}
  ],
  "tags": [
    {"name": "health", "description": "Liveness / readiness"},
    {"name": "manifests", "description": "Manifest CRUD"},
    {"name": "integrations", "description": "Integration instances and runtime state"},
    {"name": "workflows", "description": "Workflow runs"},
    {"name": "events", "description": "Event stream publish (reactive triggers)"},
    {"name": "webhooks", "description": "Inbound webhook routing"},
    {"name": "secrets", "description": "Managed secret store"},
    {"name": "products", "description": "Informational product manifests (deploy is via repository_binding in v2.0.0+)"}
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["health"],
        "summary": "Service banner",
        "responses": {
          "200": {
            "description": "Banner",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ServiceBanner"}}}
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": ["health"],
        "summary": "Liveness probe (text/plain)",
        "responses": {"200": {"description": "ok", "content": {"text/plain": {"schema": {"type": "string", "example": "ok"}}}}}
      }
    },
    "/readyz": {
      "get": {
        "tags": ["health"],
        "summary": "Readiness probe; checks postgres",
        "responses": {
          "200": {"description": "Ready", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReadyResponse"}}}},
          "503": {"description": "Not ready", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReadyResponse"}}}}
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": ["health"],
        "summary": "Returns this OpenAPI spec",
        "responses": {"200": {"description": "OpenAPI 3.0.3 document", "content": {"application/json": {}}}}
      }
    },
    "/api/v1/manifests": {
      "get": {
        "tags": ["manifests"],
        "summary": "List manifests by kind",
        "security": [{"BearerAuth": []}],
        "parameters": [
          {"name": "kind", "in": "query", "required": true, "schema": {"type": "string"}, "description": "e.g. integration_type, integration_instance, workflow, repository_binding, secret_intent, product, control_plane, surface, rbac, policy"},
          {"name": "namespace", "in": "query", "schema": {"type": "string"}},
          {"name": "name", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "Array of manifests",
            "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Manifest"}}}}
          }
        }
      },
      "post": {
        "tags": ["manifests"],
        "summary": "Create a manifest version",
        "security": [{"BearerAuth": []}],
        "parameters": [
          {"name": "kind", "in": "query", "required": true, "schema": {"type": "string"}}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ManifestCreateRequest"}}}
        },
        "responses": {
          "201": {"description": "Created", "content": {"application/json": {"schema": {"type": "object", "properties": {"manifest": {"$ref": "#/components/schemas/Manifest"}}}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "409": {"description": "Conflict (e.g. repository_binding unique on spec.repository)", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
        }
      }
    },
    "/api/v1/manifests/{id}": {
      "delete": {
        "tags": ["manifests"],
        "summary": "Delete a manifest by id (idempotent)",
        "description": "Removes every manifest row sharing the (kind, namespace, name) of the supplied version id. Default mode hard-deletes rows; ?soft=true flips active=FALSE while preserving history. Returns 200 with already_absent=true if the id is unknown so periodic purge retries don't trip on transient races. Requires an authorized console session; workflow machine credentials are never accepted.",
        "security": [{"BearerAuth": []}],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}, "description": "Manifest version id (the UUID returned by POST/GET)"},
          {"name": "soft", "in": "query", "schema": {"type": "boolean", "default": false}, "description": "If true, mark active=FALSE on every version row sharing (kind, namespace, name); otherwise hard-delete those rows."}
        ],
        "responses": {
          "200": {
            "description": "Deleted (or already absent — idempotent)",
            "content": {"application/json": {"schema": {"type": "object", "properties": {"deleted": {"type": "boolean"}, "mode": {"type": "string", "enum": ["hard", "soft"]}, "rows_affected": {"type": "integer"}, "already_absent": {"type": "boolean"}}}}}
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/api/v1/events": {
      "post": {
        "tags": ["events"],
        "summary": "Publish an event into the event stream",
        "description": "Two-shape endpoint. Generic control-plane events use `type`, `aggregate_type`, `aggregate_id`, `payload` from trusted in-process paths or credential-free local development (an explicit development YGGDRASIL_ENV, ADR-0022). Adapter pods emit INTEGRATION_CONTRACT 6.5 mutation events with `event_type`, `provider`, `resource`, `verb`, `resource_id`, `instance_id`, `idempotency`, `observed`, `emitted_at`, one per successful ensure_*/destroy_*/allowlisted-create_*. Mutation events dedup against `(event_type, idempotency)` within the event_retention_policy TTL: re-posting returns 200 with the original event_id instead of duplicating the row. Hashed machine publishers may submit only mutation events their grants cover. A grant whose instance_id has no `/` is exact and matches the event's instance_id as an opaque string with no database access. A grant `<namespace>/<name>` is logical (ADR-0021): it matches only after Core resolves the event's instance_id (the canonical UUID of any not-yet-purged version, or a literal `<namespace>/<name>`, never a bare name) to an integration_instance with an active version whose active integration_type provider equals the event provider. The server stamps `yggdrasil.io/publisher_grant_form` and, for a logical grant, `yggdrasil.io/publisher_instance_namespace`, `_name`, `_manifest_id` and `_version` into the event metadata, and drops any client value under `yggdrasil.io/publisher_`. The explicit time-bounded plaintext bridge is also mutation-only and receives a reserved server-authored actor. Human console sessions and workflow credentials are never accepted.",
        "security": [{"BearerAuth": []}, {"EventPublishToken": []}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PublishEventRequest"}}}
        },
        "responses": {
          "201": {"description": "Event persisted (fresh insert)", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PublishEventResponse"}}}},
          "200": {"description": "Mutation event deduped (idempotency hit); body carries the original event_id and deduped:true", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PublishEventResponse"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"description": "event.authorization_denied: the event is generic for a machine or migration credential, or no exact or logical grant of the hashed publisher covers its provider, instance and event type. Not found, not granted and a wrong type provider share one identical body.", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/EventPublishProblem"}}}},
          "503": {"description": "event.authorization_unavailable: a logical grant needed the integration instance lookup and the database did not answer. The detail is fixed; retry later.", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/EventPublishProblem"}}}}
        }
      }
    },
    "/api/v1/events/authorization": {
      "post": {
        "tags": ["events"],
        "summary": "Prove the effective grant of an event publisher without publishing",
        "description": "Authenticates an active hashed event-publisher principal, applies the same exact/logical grant decision as POST /api/v1/events and performs no persistence. Legacy migration, workflow and console credentials are rejected. The response excludes bearer material and configured credential digests; grant_set_sha256 covers the complete lexicographically sorted grant set (ADR-0026).",
        "security": [{"EventPublishToken": []}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["provider", "instance_id", "event_type"], "properties": {"provider": {"type": "string"}, "instance_id": {"type": "string"}, "event_type": {"type": "string"}}}}}},
        "responses": {
          "200": {"description": "The authenticated principal holds the queried grant", "content": {"application/json": {"schema": {"type": "object", "required": ["allowed", "principal_id", "provider", "instance_id", "event_type", "grant_form", "grant_count", "grant_set_sha256", "principal_expires_at"], "properties": {"allowed": {"type": "boolean", "enum": [true]}, "principal_id": {"type": "string"}, "provider": {"type": "string"}, "instance_id": {"type": "string"}, "event_type": {"type": "string"}, "grant_form": {"type": "string", "enum": ["exact", "logical"]}, "grant_count": {"type": "integer", "minimum": 1}, "grant_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "principal_expires_at": {"type": "string", "format": "date-time"}}}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"description": "event.authorization_denied: the credential is not a hashed principal or the queried tuple is not granted", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/EventPublishProblem"}}}},
          "503": {"description": "event.authorization_unavailable: a logical grant lookup failed", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/EventPublishProblem"}}}}
        }
      }
    },
    "/api/v1/integration-instances": {
      "get": {
        "tags": ["integrations"],
        "summary": "List integration instances",
        "responses": {
          "200": {"description": "Instances", "content": {"application/json": {"schema": {"type": "object", "properties": {"integration_instances": {"type": "array", "items": {"$ref": "#/components/schemas/Manifest"}}}}}}}
        }
      },
      "post": {
        "tags": ["integrations"],
        "summary": "Create an integration_instance manifest",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/IntegrationInstanceCreate"}}}},
        "responses": {"201": {"description": "Created"}, "400": {"$ref": "#/components/responses/BadRequest"}}
      }
    },
    "/api/v1/ops/integration-instances/{namespace}/{name}/reactor-dispatch": {
      "parameters": [
        {"name": "namespace", "in": "path", "required": true, "schema": {"type": "string"}, "description": "Logical integration instance namespace"},
        {"name": "name", "in": "path", "required": true, "schema": {"type": "string"}, "description": "Logical integration instance name"}
      ],
      "get": {
        "tags": ["integrations"],
        "summary": "Read the operator-owned reactor dispatch pause for an active integration instance",
        "description": "Requires yggdrasil:view_integrations. An active instance without a policy returns an empty paused_event_types list and revision 0. The policy is keyed by logical namespace/name and survives manifest version changes and deletion.",
        "security": [{"BearerAuth": []}],
        "responses": {
          "200": {"description": "Current exact pause set and revision", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReactorDispatchPolicy"}}}},
          "401": {"description": "Verified console session required"},
          "403": {"description": "Missing yggdrasil:view_integrations permission"},
          "404": {"description": "No active integration instance has this logical name"}
        }
      },
      "put": {
        "tags": ["integrations"],
        "summary": "Atomically replace the exact reactor dispatch pause set",
        "description": "Requires yggdrasil:manage_integrations and a verified console collaborator ID. The expected_revision compare-and-swap prevents lost updates; GET and reconsider the policy after a 409. The replacement and success audit row commit together. An empty paused_event_types list resumes dispatch. This is not a strict drain: an adapter call can start after PUT returns if the policy changes between the last worker recheck and RPC start.",
        "security": [{"BearerAuth": []}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReactorDispatchPolicyReplaceRequest"}}}},
        "responses": {
          "200": {"description": "Replacement committed with a new revision and audit row", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReactorDispatchPolicy"}}}},
          "400": {"description": "Missing or invalid fields, event names, duplicates, or more than 128 event types"},
          "401": {"description": "Verified console session with a valid collaborator ID required"},
          "403": {"description": "Missing yggdrasil:manage_integrations permission"},
          "404": {"description": "No active integration instance has this logical name"},
          "409": {"description": "expected_revision does not match the current policy revision; GET again"}
        }
      }
    },
    "/api/v1/integration-runtime-states": {
      "get": {
        "tags": ["integrations"],
        "summary": "Diagnose adapter handshake / connectivity",
        "parameters": [
          {"name": "namespace", "in": "query", "schema": {"type": "string"}},
          {"name": "name", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Runtime states", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RuntimeStatesResponse"}}}}
        }
      }
    },
    "/api/v1/workflow-runs": {
      "post": {
        "tags": ["workflows"],
        "summary": "Dispatch a workflow",
        "description": "Resolves the workflow manifest, validates inputs against its schema, and enforces the authenticated machine principal's exact namespace/name allowlist. Machine dispatch must select the current active workflow by namespace/name; manifest_id and explicit version selectors are rejected. It requires spec.authorization and must also pass its RBAC and optional policy. Hashed machine principals are always routed through durable async execution so server-authored ownership and idempotency isolation apply; sync opt-out signals are ignored. Human and time-bounded migration callers may still use sync, which returns the per-step result. Core loads the machine principals and the legacy bridge settings once at start (ADR-0022): a malformed, set-but-blank or cross-scope-colliding inventory answers 401 to every machine request, and a request with no credential is accepted only when nothing is configured and YGGDRASIL_ENV is explicitly dev, development, local or test. Every request the legacy bridge authenticates is logged, counted and audited as workflow_run.legacy_bridge, and its async runs carry yggdrasil.io/creator_legacy_workflow_bridge=true.",
        "security": [{"BearerAuth": []}, {"WorkflowToken": []}],
        "parameters": [
          {"name": "async", "in": "query", "schema": {"type": "boolean"}, "description": "Select dispatch mode for human and migration callers. Hashed machine principals are always asynchronous, even when false."}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunWorkflowRequest"}}}
        },
        "responses": {
          "201": {"description": "Synchronous run finished for a human or migration caller", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunWorkflowResponse"}}}},
          "202": {"description": "Asynchronous run persisted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkflowRunAccepted"}}}},
          "200": {"description": "Owned idempotent async retry", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkflowRunAccepted"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"description": "Machine selector is not current-active namespace/name, workflow is outside the allowlist, lacks required machine authorization, or is denied by manifest authorization"}
        }
      }
    },
    "/api/v1/workflow-runs/{run_id}": {
      "get": {
        "tags": ["workflows"],
        "summary": "Poll an asynchronous workflow run",
        "description": "Machine principals receive only runs created by the same authenticated principal. Foreign and absent run ids both return 404. A poll the legacy bridge authenticates is counted every time and audited as workflow_run.legacy_bridge once per run id per process (ADR-0022).",
        "security": [{"BearerAuth": []}, {"WorkflowToken": []}],
        "parameters": [
          {"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
        ],
        "responses": {
          "200": {"description": "Owned workflow run", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkflowRunRecord"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"description": "Run absent or not owned by this machine principal"}
        }
      }
    },
    "/api/v1/github/webhook": {
      "post": {
        "tags": ["webhooks"],
        "summary": "GitHub push webhook receiver",
        "description": "Verifies the X-Hub-Signature-256 HMAC, looks up the `repository_binding` for `repository.full_name`, applies branch and path filters, and dispatches the bound workflow. Returns 200 with `status: skipped` when no binding is configured (so a webhook on an unmapped repo is harmless). A repository binding cannot dispatch a workflow that declares `spec.authorization` because the webhook carries no authenticated Core actor. While the emergency workflow dispatch lock is enforced, push dispatch returns 503 before binding lookup even when the bound workflow is allowlisted.",
        "parameters": [
          {"name": "X-GitHub-Event", "in": "header", "required": true, "schema": {"type": "string", "enum": ["push", "ping"]}},
          {"name": "X-Hub-Signature-256", "in": "header", "schema": {"type": "string", "example": "sha256=abc..."}}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GitHubPushEvent"}}}},
        "responses": {
          "200": {"description": "Skipped (no binding) or ping pong", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebhookSkipResponse"}}}},
          "202": {"description": "Workflow dispatched", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebhookDispatchResponse"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"description": "Invalid HMAC signature", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "501": {"description": "github_actions dispatch is reserved (not implemented in v2.0.0)", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "503": {"description": "Emergency workflow dispatch lock refuses repository-binding push dispatch", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
        }
      }
    },
    "/api/v1/secrets": {
      "get": {
        "tags": ["secrets"],
        "summary": "List managed secrets (metadata only)",
        "responses": {"200": {"description": "Metadata list", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/SecretMetadata"}}}}}}
      },
      "post": {
        "tags": ["secrets"],
        "summary": "Create a managed secret",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SecretCreate"}}}},
        "responses": {"201": {"description": "Created"}, "400": {"$ref": "#/components/responses/BadRequest"}}
      }
    },
    "/api/v1/secrets/{namespace}/{name}": {
      "get": {
        "tags": ["secrets"],
        "summary": "Get one managed secret (metadata only; values not returned)",
        "parameters": [
          {"name": "namespace", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "name", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Secret metadata", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SecretMetadata"}}}}, "404": {"$ref": "#/components/responses/NotFound"}}
      }
    },
    "/api/v1/products": {
      "get": {
        "tags": ["products"],
        "summary": "List product manifests (informational only since v2.0.0)",
        "responses": {"200": {"description": "Products"}}
      },
      "post": {
        "tags": ["products"],
        "summary": "Create a product manifest (informational; does not deploy)",
        "responses": {"201": {"description": "Created"}}
      }
    },
    "/api/v1/products/{namespace}/{name}/deploy": {
      "post": {
        "tags": ["products"],
        "summary": "Deprecated since v2.0.0 — returns 410 Gone",
        "deprecated": true,
        "parameters": [
          {"name": "namespace", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "name", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "410": {"description": "Gone — use repository_binding + workflow dispatch", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DeprecationResponse"}}}}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {"type": "http", "scheme": "bearer", "description": "Route-appropriate console session or machine bearer in the Authorization header"},
      "EventPublishToken": {"type": "apiKey", "in": "header", "name": "X-Yggdrasil-Event-Token", "description": "Mutation-event publisher bearer whose SHA-256 digest and exact or logical grants are configured in YGGDRASIL_EVENT_PUBLISHER_PRINCIPALS_JSON, or the explicit time-bounded mutation-only plaintext migration bridge"},
      "WorkflowToken": {"type": "apiKey", "in": "header", "name": "X-Yggdrasil-Workflow-Token", "description": "Workflow machine bearer whose SHA-256 digest and exact allowlist are configured in YGGDRASIL_WORKFLOW_MACHINE_PRINCIPALS_JSON, or the explicit time-bounded legacy workflow bridge"}
    },
    "schemas": {
      "ServiceBanner": {"type": "object", "properties": {"service": {"type": "string"}, "status": {"type": "string"}}},
      "ReadyResponse": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string", "enum": ["ready", "not_ready"]}, "rabbitmq_status": {"type": "string", "enum": ["ok", "degraded"]}, "reason": {"type": "string"}, "error": {"type": "string"}}},
      "ReactorDispatchPolicy": {
        "type": "object",
        "required": ["namespace", "name", "paused_event_types", "revision"],
        "properties": {
          "namespace": {"type": "string"},
          "name": {"type": "string"},
          "paused_event_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "maxItems": 128, "description": "Sorted exact event names whose reactor dispatch is paused"},
          "revision": {"type": "integer", "format": "int64", "minimum": 0, "description": "0 when no policy has been written; increments on every successful replacement"},
          "updated_at": {"type": "string", "format": "date-time", "description": "Timestamp of the last policy replacement when available"}
        }
      },
      "ReactorDispatchPolicyReplaceRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paused_event_types", "expected_revision"],
        "properties": {
          "paused_event_types": {"type": "array", "items": {"type": "string", "description": "Exact canonical lifecycle name or integration mutation name <provider>.<resource>.(ensured|destroyed|created)"}, "uniqueItems": true, "maxItems": 128, "description": "Full replacement set; [] resumes every event type"},
          "expected_revision": {"type": "integer", "format": "int64", "minimum": 0, "description": "Current revision from GET; required for compare-and-swap"}
        }
      },
      "ManifestMetadata": {
        "type": "object",
        "required": ["name", "namespace"],
        "properties": {
          "name": {"type": "string"},
          "namespace": {"type": "string"},
          "description": {"type": "string"},
          "labels": {"type": "object", "additionalProperties": {"type": "string"}},
          "active": {"type": "boolean"}
        }
      },
      "Manifest": {
        "type": "object",
        "required": ["id", "apiVersion", "kind", "metadata", "version", "spec"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "apiVersion": {"type": "string", "example": "yggdrasil.io/v1alpha1"},
          "kind": {"type": "string"},
          "metadata": {"$ref": "#/components/schemas/ManifestMetadata"},
          "version": {"type": "integer"},
          "checksum": {"type": "string"},
          "spec": {"type": "object", "additionalProperties": true},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        }
      },
      "ManifestCreateRequest": {
        "type": "object",
        "required": ["name", "spec"],
        "properties": {
          "name": {"type": "string"},
          "namespace": {"type": "string", "default": "global"},
          "description": {"type": "string"},
          "labels": {"type": "object", "additionalProperties": {"type": "string"}},
          "spec": {"type": "object", "additionalProperties": true, "description": "Kind-specific spec; validated server-side"}
        }
      },
      "IntegrationInstanceCreate": {
        "type": "object",
        "required": ["name", "type_ref"],
        "properties": {
          "name": {"type": "string"},
          "namespace": {"type": "string", "default": "global"},
          "description": {"type": "string"},
          "type_ref": {"$ref": "#/components/schemas/ManifestSelector"},
          "status": {"type": "string", "enum": ["active", "draft", "disabled"], "default": "active"},
          "owners": {"type": "array", "items": {"type": "string"}},
          "credentials": {"type": "object", "additionalProperties": true},
          "credentials_ref": {"type": "string", "description": "secret:// reference to managed secret"},
          "config": {"type": "object", "additionalProperties": true},
          "discovery": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "mode": {"type": "string", "enum": ["manual", "automatic"]}, "sync_interval_seconds": {"type": "integer"}}},
          "execution": {"type": "object", "properties": {"default_dry_run": {"type": "boolean"}, "max_batch_size": {"type": "integer"}}}
        }
      },
      "ManifestSelector": {
        "type": "object",
        "properties": {
          "manifest_id": {"type": "string", "format": "uuid"},
          "namespace": {"type": "string"},
          "name": {"type": "string"},
          "version": {"type": "integer"}
        }
      },
      "RuntimeStatesResponse": {
        "type": "object",
        "properties": {"runtime_states": {"type": "array", "items": {"$ref": "#/components/schemas/RuntimeState"}}}
      },
      "RuntimeState": {
        "type": "object",
        "properties": {
          "integration_instance": {"$ref": "#/components/schemas/ManifestReference"},
          "integration_type": {"$ref": "#/components/schemas/ManifestReference"},
          "check_kind": {"type": "string", "enum": ["describe_handshake", "transport_connectivity", "credentials_validity"]},
          "status": {"type": "string", "enum": ["healthy", "unreachable", "contract_mismatch", "unauthorized"]},
          "message": {"type": "string"},
          "details": {"type": "object", "additionalProperties": true},
          "checked_at": {"type": "string", "format": "date-time"}
        }
      },
      "ManifestReference": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "kind": {"type": "string"},
          "namespace": {"type": "string"},
          "name": {"type": "string"},
          "version": {"type": "integer"}
        }
      },
      "RunWorkflowRequest": {
        "type": "object",
        "required": ["workflow"],
        "properties": {
          "workflow": {"$ref": "#/components/schemas/ManifestSelector"},
          "inputs": {"type": "object", "additionalProperties": true},
          "auth": {"type": "object", "properties": {"token": {"type": "string"}}},
          "metadata": {"type": "object", "additionalProperties": true}
        }
      },
      "RunWorkflowResponse": {
        "type": "object",
        "properties": {
          "workflow": {"$ref": "#/components/schemas/ManifestReference"},
          "status": {"type": "string", "enum": ["succeeded", "failed", "running", "cancelled"]},
          "steps": {"type": "array", "items": {"$ref": "#/components/schemas/WorkflowStepResult"}},
          "metadata": {"type": "object", "additionalProperties": true},
          "started_at": {"type": "string", "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"}
        }
      },
      "WorkflowRunAccepted": {
        "type": "object",
        "required": ["run_id", "status", "workflow", "deduped"],
        "properties": {
          "run_id": {"type": "string", "format": "uuid"},
          "status": {"type": "string", "enum": ["pending", "accepted"]},
          "workflow": {"$ref": "#/components/schemas/ManifestSelector"},
          "deduped": {"type": "boolean"}
        }
      },
      "WorkflowRunRecord": {
        "type": "object",
        "required": ["id", "workflow_namespace", "workflow_name", "status", "created_at", "updated_at"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "workflow_namespace": {"type": "string"},
          "workflow_name": {"type": "string"},
          "workflow_version": {"type": "integer"},
          "status": {"type": "string", "enum": ["pending", "running", "succeeded", "failed", "cancelled"]},
          "inputs": {"type": "object", "additionalProperties": true},
          "metadata": {"type": "object", "additionalProperties": true},
          "result": {"$ref": "#/components/schemas/RunWorkflowResponse"},
          "error": {"type": "string"},
          "started_at": {"type": "string", "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        }
      },
      "WorkflowStepResult": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string"},
          "operation": {"type": "string"},
          "capability": {"type": "string"},
          "status": {"type": "string", "enum": ["succeeded", "failed", "skipped"]},
          "attempts": {"type": "integer"},
          "error": {"type": "string"},
          "metadata": {"type": "object", "additionalProperties": true},
          "started_at": {"type": "string", "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"}
        }
      },
      "GitHubPushEvent": {
        "type": "object",
        "properties": {
          "ref": {"type": "string", "example": "refs/heads/main"},
          "repository": {"type": "object", "properties": {"full_name": {"type": "string"}, "clone_url": {"type": "string"}}},
          "head_commit": {"type": "object", "properties": {"id": {"type": "string"}, "message": {"type": "string"}, "modified": {"type": "array", "items": {"type": "string"}}}},
          "pusher": {"type": "object", "properties": {"name": {"type": "string"}}}
        }
      },
      "WebhookSkipResponse": {
        "type": "object",
        "properties": {"status": {"type": "string", "enum": ["skipped", "pong", "ignored"]}, "reason": {"type": "string"}, "event": {"type": "string"}}
      },
      "WebhookDispatchResponse": {
        "type": "object",
        "properties": {"status": {"type": "string", "enum": ["deploying"]}, "workflow": {"type": "string"}, "binding": {"type": "string"}, "repo": {"type": "string"}}
      },
      "SecretMetadata": {
        "type": "object",
        "properties": {
          "namespace": {"type": "string"},
          "name": {"type": "string"},
          "status": {"type": "string", "enum": ["active", "disabled", "revoked"]},
          "version": {"type": "integer"},
          "rotation": {"type": "object", "additionalProperties": true},
          "expires_at": {"type": "string", "format": "date-time"},
          "metadata": {"type": "object", "additionalProperties": true}
        }
      },
      "SecretCreate": {
        "type": "object",
        "required": ["namespace", "name", "data"],
        "properties": {
          "namespace": {"type": "string"},
          "name": {"type": "string"},
          "data": {"type": "object", "description": "Map of key/value entries; values are not returned by GET", "additionalProperties": {"type": "string"}},
          "metadata": {"type": "object", "additionalProperties": true},
          "rotation": {"type": "object", "additionalProperties": true}
        }
      },
      "PublishEventRequest": {
        "type": "object",
        "description": "Accepts either the generic event shape (type/aggregate_type/aggregate_id/payload) or the INTEGRATION_CONTRACT 6.5 mutation shape (event_type/provider/resource/verb/resource_id/instance_id/idempotency/observed/emitted_at). Presence of event_type selects the mutation branch.",
        "properties": {
          "type": {"type": "string", "description": "Generic shape — event type, e.g. infra.alert.firing or manifest.created"},
          "schema_version": {"type": "string", "default": "v1"},
          "aggregate_type": {"type": "string", "description": "Generic shape — aggregate kind"},
          "aggregate_id": {"type": "string", "description": "Generic shape — aggregate identity"},
          "payload": {"type": "object", "additionalProperties": true, "description": "Generic shape — payload validated against the registered JSON schema"},
          "actor": {"type": "object", "properties": {"type": {"type": "string"}, "id": {"type": "string"}, "context": {"type": "object", "additionalProperties": true}}},
          "metadata": {"type": "object", "additionalProperties": true},

          "event_type":  {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.(ensured|destroyed|created)$", "description": "Mutation shape — <provider>.<resource>.<verb_past>"},
          "provider":    {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "Mutation shape — adapter family (e.g. stripe, efi, github)"},
          "resource":    {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "Mutation shape — resource type the adapter manages"},
          "verb":        {"type": "string", "enum": ["ensured", "destroyed", "created"], "description": "Mutation shape — past-tense verb; MUST match the verb suffix of event_type"},
          "resource_id": {"type": "string", "description": "Mutation shape — provider-side stable identity"},
          "instance_id": {"type": "string", "description": "Mutation shape — integration_instance scope (multi-tenant)"},
          "idempotency": {"type": "string", "maxLength": 256, "description": "Mutation shape — dedup key for safe retries"},
          "observed":    {"type": "object", "additionalProperties": true, "description": "Mutation shape — full observed state at emission time"},
          "emitted_at":  {"type": "string", "format": "date-time", "description": "Mutation shape — adapter-side timestamp of the mutation"}
        }
      },
      "PublishEventResponse": {
        "type": "object",
        "required": ["event_id"],
        "properties": {
          "event_id": {"type": "string", "format": "uuid"},
          "materialized_reactions": {"type": "integer", "minimum": 0, "description": "Number of integration_event_reactions rows fanned out in the same Tx as the event insert"},
          "deduped": {"type": "boolean", "description": "True when the mutation event hit the (event_type, idempotency) unique slot — body carries the original event_id"}
        }
      },
      "EventPublishProblem": {"type": "object", "description": "RFC 7807 problem body of the event publish authorization decision", "properties": {"type": {"type": "string"}, "title": {"type": "string"}, "status": {"type": "integer"}, "code": {"type": "string", "enum": ["event.authorization_denied", "event.authorization_unavailable"]}, "detail": {"type": "string"}}},
      "ErrorResponse": {"type": "object", "properties": {"error": {"type": "string"}, "deprecation": {"type": "string"}}},
      "DeprecationResponse": {"type": "object", "properties": {"error": {"type": "string"}, "deprecation": {"type": "string", "example": "yggdrasil v2.0.0"}}}
    },
    "responses": {
      "BadRequest": {"description": "Invalid request", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "Unauthorized": {"description": "Unauthorized", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "NotFound": {"description": "Not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
    }
  }
}

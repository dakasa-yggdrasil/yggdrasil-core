# Optional local overrides for this slice.
POSTGRES_CORE_DB=yggdrasil_core
POSTGRES_USER=postgres
POSTGRES_PASSWORD=someAwesomePassword
CORE_HTTP_PORT=9080
# Opt-in AMQP rpc.Transport backend. Uncomment + run with
# `docker compose --profile amqp up -d` to enable.
# BROKER_URL=amqp://guest:guest@yggdrasil-rabbitmq:5672/
AUTH_SESSION_TTL_HOURS=720
AUTH_SESSION_COOKIE_NAME=yggdrasil_session
AUTH_SESSION_COOKIE_DOMAIN=
AUTH_SESSION_COOKIE_SECURE=false
HTTP_READ_HEADER_TIMEOUT_SECONDS=10
HTTP_READ_TIMEOUT_SECONDS=30
HTTP_WRITE_TIMEOUT_SECONDS=30
HTTP_IDLE_TIMEOUT_SECONDS=120

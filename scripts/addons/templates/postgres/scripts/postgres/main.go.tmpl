package main

import (
	"context"
	"fmt"
	"time"

	"{{MODULE_PATH}}/psql"
)

func main() {
	db, err := psql.Open()
	if err != nil {
		panic(err)
	}
	defer db.Close()

	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()

	if err := db.PingContext(ctx); err != nil {
		panic(err)
	}

	fmt.Println("postgres: ok")
}

package controllers

import (
	"net/http"

	"{{MODULE_PATH}}/securities"
	"github.com/gin-gonic/gin"
)

// CurrentJWTClaims returns the validated JWT claims for debugging and bootstrap flows.
func CurrentJWTClaims() gin.HandlerFunc {
	return func(c *gin.Context) {
		_, claims, err := securities.ValidateJWT(c.GetHeader("X-JWT"))
		if err != nil {
			c.JSON(http.StatusUnauthorized, gin.H{"msg": "Unauthorized"})
			return
		}

		c.JSON(http.StatusOK, gin.H{
			"claims": claims,
		})
	}
}

package main

import (
	"flag"
	"fmt"
	"os"
	"time"

	"github.com/golang-jwt/jwt/v5"
)

func main() {
	if len(os.Args) < 2 {
		usage()
		os.Exit(1)
	}

	switch os.Args[1] {
	case "mint":
		if err := mint(os.Args[2:]); err != nil {
			fmt.Fprintf(os.Stderr, "auth script error: %v\n", err)
			os.Exit(1)
		}
	default:
		usage()
		os.Exit(1)
	}
}

func usage() {
	fmt.Println("auth helper")
	fmt.Println()
	fmt.Println("Usage:")
	fmt.Println("  go run ./scripts/auth mint --issuer user-123 --subject user-123 --role member")
}

func mint(args []string) error {
	fs := flag.NewFlagSet("mint", flag.ContinueOnError)
	issuer := fs.String("issuer", "user-123", "JWT issuer")
	subject := fs.String("subject", "user-123", "JWT subject")
	role := fs.String("role", "member", "Role claim")
	ttl := fs.Duration("ttl", 24*time.Hour, "Token TTL")
	if err := fs.Parse(args); err != nil {
		return err
	}

	secret := os.Getenv("JWT_KEY")
	if secret == "" {
		return fmt.Errorf("JWT_KEY is not set")
	}

	token := jwt.NewWithClaims(jwt.SigningMethodHS256, jwt.MapClaims{
		"iss":  *issuer,
		"sub":  *subject,
		"role": *role,
		"exp":  time.Now().Add(*ttl).Unix(),
		"iat":  time.Now().Unix(),
	})

	signed, err := token.SignedString([]byte(secret))
	if err != nil {
		return err
	}

	fmt.Println(signed)
	return nil
}

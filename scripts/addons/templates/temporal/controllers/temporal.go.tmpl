package controllers

import (
	"fmt"
	"net/http"
	"strings"
	"time"

	"{{MODULE_PATH}}/internal/runtime"
	serviceTemporal "{{MODULE_PATH}}/temporal"

	"github.com/gin-gonic/gin"
	tc "go.temporal.io/sdk/client"
)

// RunTemporalHello starts the sample Temporal workflow generated by the addon.
func RunTemporalHello(app *runtime.ServiceApp) gin.HandlerFunc {
	return func(c *gin.Context) {
		resource, ok := app.Resource("temporal")
		if !ok {
			c.JSON(http.StatusServiceUnavailable, gin.H{"msg": "Temporal client is not available"})
			return
		}

		cli, ok := resource.(tc.Client)
		if !ok {
			c.JSON(http.StatusServiceUnavailable, gin.H{"msg": "Temporal client is not available"})
			return
		}

		name := strings.TrimSpace(c.Query("name"))
		if name == "" {
			name = "world"
		}

		run, err := cli.ExecuteWorkflow(c.Request.Context(), tc.StartWorkflowOptions{
			ID:        fmt.Sprintf("%s-hello-%d", app.ServiceName, time.Now().UnixNano()),
			TaskQueue: serviceTemporal.HelloWorkflowTaskQueue,
		}, serviceTemporal.HelloWorkflow, serviceTemporal.HelloInput{Name: name})
		if err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{"msg": err.Error()})
			return
		}

		c.JSON(http.StatusAccepted, gin.H{
			"workflowID": run.GetID(),
			"runID":      run.GetRunID(),
			"taskQueue":  serviceTemporal.HelloWorkflowTaskQueue,
		})
	}
}

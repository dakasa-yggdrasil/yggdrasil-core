package addons

import (
	"context"
	"fmt"
	"os"
	"strconv"
	"strings"

	"{{MODULE_PATH}}/internal/runtime"
	"{{MODULE_PATH}}/outbox"
	"{{MODULE_PATH}}/store"
	"go.uber.org/zap"
)

func init() {
	Register("outbox", bootstrapOutbox, 50)
}

func bootstrapOutbox(_ context.Context, app *runtime.ServiceApp) error {
	outbox.RegisterMetrics()

	logger := zap.NewNop()
	if resource, ok := app.Resource("logger"); ok {
		if candidate, ok := resource.(*zap.Logger); ok && candidate != nil {
			logger = candidate
		}
	}

	conn, ok := RabbitMQ(app)
	if !ok {
		return fmt.Errorf("rabbitmq addon is required before outbox")
	}
	rdb, ok := Redis(app)
	if !ok {
		return fmt.Errorf("redis addon is required before outbox")
	}
	db, ok := Postgres(app)
	if !ok {
		return fmt.Errorf("postgres addon is required before outbox")
	}

	if enabledFromEnv("OUTBOX_ENABLE_FAST", true) {
		ch, err := conn.Channel()
		if err != nil {
			return fmt.Errorf("open fast outbox channel: %w", err)
		}
		namespace := strings.TrimSpace(os.Getenv("OUTBOX_FAST_NAMESPACE"))
		if namespace == "" {
			namespace = store.OutboxPrefixApp
		}
		go outbox.StartWorkerFast(ch, rdb, namespace, getenvInt("OUTBOX_FAST_BATCH", 500), logger)
		app.RegisterCloser(func(context.Context) error { return ch.Close() })
	}

	if enabledFromEnv("OUTBOX_ENABLE_CRITICAL", true) {
		ch, err := conn.Channel()
		if err != nil {
			return fmt.Errorf("open critical outbox channel: %w", err)
		}
		go outbox.StartWorkerCritical(ch, db, getenvInt("OUTBOX_CRITICAL_BATCH", 300), logger)
		app.RegisterCloser(func(context.Context) error { return ch.Close() })
	}

	return nil
}

func enabledFromEnv(key string, fallback bool) bool {
	raw := strings.TrimSpace(strings.ToLower(os.Getenv(key)))
	if raw == "" {
		return fallback
	}
	switch raw {
	case "1", "true", "yes", "on":
		return true
	case "0", "false", "no", "off":
		return false
	default:
		return fallback
	}
}

func getenvInt(key string, fallback int) int {
	raw := strings.TrimSpace(os.Getenv(key))
	if raw == "" {
		return fallback
	}
	value, err := strconv.Atoi(raw)
	if err != nil || value <= 0 {
		return fallback
	}
	return value
}

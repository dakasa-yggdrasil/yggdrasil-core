{
  "apiVersion": "yggdrasil.io/v1alpha1",
  "kind": "integration_type",
  "metadata": {
    "name": "github",
    "namespace": "global",
    "description": "Bootstrap integration type for the GitHub runtime and governance plugin.",
    "labels": {
      "bootstrap_source": "integration-github",
      "provider": "github",
      "yggdrasil.io/catalog-domain": "github",
      "yggdrasil.io/catalog-entry": "api",
      "yggdrasil.io/catalog-section": "operations"
    }
  },
  "spec": {
    "adapter": {
      "version": "1.1.1",
      "endpoints": {
        "execute": "/rpc/execute",
        "describe": "/rpc/describe"
      },
      "transport": "http_json",
      "timeout_seconds": 30
    },
    "provider": "github",
    "discovery": {
      "mode": "push",
      "cursor": "none"
    },
    "execution": {
      "supports_dry_run": false
    },
    "extensions": {},
    "capabilities": [
      "describe",
      "execute"
    ],
    "normalization": {
      "name_path": "name",
      "owner_path": "owner.login",
      "external_id_path": "full_name",
      "fallback_resource_prefix": "thirdparty.github.custom"
    },
    "action_catalog": [
      {
        "name": "dispatch_workflow",
        "description": "Dispatch one GitHub Actions workflow run.",
        "resource_types": [
          "repository"
        ]
      },
      {
        "name": "catalog_discover",
        "idempotent": true,
        "description": "Discover integration and surface candidates from one GitHub owner scope.",
        "resource_types": [
          "catalog_entry"
        ]
      },
      {
        "name": "create_repository",
        "idempotent": false,
        "description": "Create one GitHub repository in a user or organization scope.",
        "resource_types": [
          "repository"
        ]
      },
      {
        "name": "upsert_environment",
        "idempotent": true,
        "description": "Create or update one GitHub environment on a repository.",
        "resource_types": [
          "environment"
        ]
      },
      {
        "name": "grant_team_repository_access",
        "idempotent": true,
        "description": "Ensure one GitHub team has the desired permission on a repository.",
        "resource_types": [
          "team_repository_access"
        ]
      }
    ],
    "resource_types": [
      {
        "name": "repository",
        "discoverable": false,
        "default_actions": [
          "dispatch_workflow",
          "create_repository"
        ],
        "canonical_prefix": "thirdparty.github.repository",
        "identity_template": "repository.{repository}"
      },
      {
        "name": "environment",
        "discoverable": false,
        "default_actions": [
          "upsert_environment"
        ],
        "canonical_prefix": "thirdparty.github.environment",
        "identity_template": "environment.{repository}.{environment}"
      },
      {
        "name": "team_repository_access",
        "discoverable": false,
        "default_actions": [
          "grant_team_repository_access"
        ],
        "canonical_prefix": "thirdparty.github.team_repository_access",
        "identity_template": "team_repository_access.{organization}.{team_slug}.{repository}"
      },
      {
        "name": "catalog_entry",
        "discoverable": false,
        "default_actions": [
          "catalog_discover"
        ],
        "canonical_prefix": "thirdparty.github.catalog_entry",
        "identity_template": "catalog_entry.{name}"
      }
    ],
    "instance_schema": {
      "mode": "inline",
      "properties": {
        "base_url": {
          "type": "string",
          "description": "HTTP adapter base URL used when the integration_type declares transport=http_json."
        },
        "default_ref": {
          "type": "string",
          "default": "main",
          "description": "Default Git ref used for workflow dispatches."
        },
        "api_base_url": {
          "type": "string",
          "default": "https://api.github.com",
          "description": "GitHub API base URL, useful for GitHub Enterprise."
        },
        "catalog_owner": {
          "type": "string",
          "description": "Organization or user scanned when catalog_discover omits one."
        },
        "default_owner": {
          "type": "string",
          "description": "Default repository owner used when the request omits one."
        },
        "default_workflow": {
          "type": "string",
          "description": "Default workflow filename used when the request omits one."
        },
        "catalog_owner_type": {
          "enum": [
            "org",
            "user"
          ],
          "type": "string",
          "default": "org",
          "description": "Whether catalog_discover should scan an organization or user scope."
        },
        "default_visibility": {
          "type": "string",
          "default": "private",
          "description": "Default repository visibility for create_repository."
        }
      }
    },
    "guardian_support": {
      "mode": "light",
      "signals": {
        "error_rate": [
          "error_rate",
          "failure_rate"
        ],
        "auth_denied": [
          "auth_denied",
          "unauthorized",
          "forbidden"
        ],
        "rate_limited": [
          "rate_limited",
          "throttled",
          "secondary_rate_limited"
        ],
        "sync_lag_seconds": [
          "sync_lag_seconds",
          "reconciliation_lag_seconds"
        ]
      }
    },
    "credential_schema": {
      "mode": "inline",
      "properties": {
        "token": {
          "type": "string",
          "secret": true,
          "description": "GitHub token used when the caller does not provide one."
        }
      }
    }
  }
}

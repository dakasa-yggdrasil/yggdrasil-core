{
  "apiVersion": "yggdrasil.io/v1alpha1",
  "kind": "integration_type",
  "metadata": {
    "name": "kubernetes",
    "namespace": "global",
    "description": "Bootstrap integration type for the Kubernetes target plugin used to apply and observe installation objects.",
    "labels": {
      "bootstrap_source": "integration-kubernetes",
      "provider": "kubernetes",
      "yggdrasil.io/catalog-domain": "kubernetes",
      "yggdrasil.io/catalog-entry": "api",
      "yggdrasil.io/catalog-section": "operations"
    }
  },
  "spec": {
    "adapter": {
      "version": "1.2.0",
      "endpoints": {
        "execute": "/rpc/execute",
        "describe": "/rpc/describe"
      },
      "transport": "http_json",
      "timeout_seconds": 30
    },
    "provider": "kubernetes",
    "discovery": {
      "mode": "push",
      "cursor": "none"
    },
    "execution": {
      "supports_dry_run": false,
      "idempotent_actions": [
        "apply_manifest",
        "declarative_apply",
        "ensure_docker_registry_secret",
        "observe_objects",
        "update_container_image"
      ]
    },
    "extensions": {
      "preserve_raw_payload": true,
      "allow_custom_resource_types": true
    },
    "capabilities": [
      "describe",
      "execute"
    ],
    "normalization": {
      "name_path": "metadata.name",
      "owner_path": "metadata.namespace",
      "external_id_path": "metadata.uid",
      "fallback_resource_prefix": "thirdparty.kubernetes.custom"
    },
    "action_catalog": [
      {
        "name": "apply_manifest",
        "idempotent": true,
        "description": "Apply a single Kubernetes manifest object using server-side apply.",
        "resource_types": [
          "object"
        ]
      },
      {
        "name": "declarative_apply",
        "idempotent": true,
        "description": "Apply a desired object set to a Kubernetes cluster using server-side apply.",
        "resource_types": [
          "object"
        ]
      },
      {
        "name": "ensure_docker_registry_secret",
        "idempotent": true,
        "description": "Create or update a Kubernetes Secret of type kubernetes.io/dockerconfigjson for image pull authentication.",
        "resource_types": [
          "object"
        ]
      },
      {
        "name": "observe_objects",
        "idempotent": true,
        "description": "Observe the current state of a desired object set in a Kubernetes cluster.",
        "resource_types": [
          "object"
        ]
      },
      {
        "name": "update_container_image",
        "idempotent": true,
        "description": "Update the image (and optionally imagePullPolicy) of a named container in an existing Deployment via strategic-merge patch by container name. Replaces fragile sparse-SSA upgrades.",
        "resource_types": [
          "object"
        ]
      }
    ],
    "resource_types": [
      {
        "name": "object",
        "discoverable": false,
        "default_actions": [
          "apply_manifest",
          "declarative_apply",
          "ensure_docker_registry_secret",
          "observe_objects",
          "update_container_image"
        ],
        "canonical_prefix": "thirdparty.kubernetes.object",
        "identity_template": "object.{namespace}.{kind}.{name}"
      }
    ],
    "instance_schema": {
      "mode": "inline",
      "properties": {
        "context": {
          "type": "string",
          "description": "Optional kubeconfig context override."
        },
        "base_url": {
          "type": "string",
          "description": "HTTP adapter base URL used when the integration_type declares transport=http_json."
        },
        "in_cluster": {
          "type": "boolean",
          "default": false,
          "description": "Use in-cluster Kubernetes authentication."
        },
        "kubeconfig": {
          "type": "string",
          "secret": true,
          "description": "Inline kubeconfig content."
        },
        "field_manager": {
          "type": "string",
          "default": "yggdrasil",
          "description": "Field manager used for server-side apply."
        },
        "kubeconfig_path": {
          "type": "string",
          "description": "Path to a kubeconfig file on the worker filesystem."
        },
        "default_namespace": {
          "type": "string",
          "default": "default",
          "description": "Namespace used when desired objects omit one."
        }
      }
    },
    "guardian_support": {
      "mode": "light",
      "signals": {
        "error_rate": [
          "error_rate",
          "failure_rate"
        ],
        "oom_killed": [
          "oom_killed",
          "oom"
        ],
        "utilization": [
          "utilization",
          "avg_utilization"
        ],
        "disk_pressure": [
          "disk_pressure"
        ],
        "restart_count": [
          "restart_count",
          "restarts"
        ],
        "memory_pressure": [
          "memory_pressure"
        ],
        "overprovisioned": [
          "overprovisioned"
        ],
        "insufficient_cpu": [
          "insufficient_cpu",
          "cpu_pressure",
          "cpu_exhausted"
        ],
        "scheduling_failure": [
          "scheduling_failure",
          "failed_scheduling",
          "unschedulable"
        ]
      }
    },
    "credential_schema": {
      "mode": "inline",
      "properties": {
        "kubeconfig": {
          "type": "string",
          "secret": true,
          "description": "Inline kubeconfig content."
        }
      }
    }
  }
}

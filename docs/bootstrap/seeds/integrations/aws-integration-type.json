{
  "apiVersion": "yggdrasil.io/v1alpha1",
  "kind": "integration_type",
  "metadata": {
    "name": "aws",
    "namespace": "global",
    "description": "Bootstrap integration type for the AWS governance plugin.",
    "labels": {
      "bootstrap_source": "integration-aws",
      "provider": "aws",
      "yggdrasil.io/catalog-domain": "aws",
      "yggdrasil.io/catalog-entry": "api",
      "yggdrasil.io/catalog-section": "operations"
    }
  },
  "spec": {
    "adapter": {
      "version": "1.0.0",
      "endpoints": {
        "execute": "/rpc/execute",
        "describe": "/rpc/describe"
      },
      "transport": "http_json",
      "timeout_seconds": 120
    },
    "provider": "aws",
    "discovery": {
      "mode": "push",
      "cursor": "none"
    },
    "execution": {
      "supports_dry_run": false,
      "idempotent_actions": [
        "ensure_s3_bucket",
        "ensure_ecr_repository",
        "upsert_secrets_manager_secret",
        "ensure_route53_zone",
        "ensure_route53_record",
        "ensure_ses_identity",
        "send_email",
        "send_sms",
        "ensure_iam_role",
        "ensure_iam_policy_attachment",
        "ensure_oidc_provider",
        "ensure_vpc",
        "ensure_subnet",
        "ensure_nat_gateway",
        "ensure_eks_cluster",
        "ensure_eks_nodegroup",
        "ensure_rds_instance",
        "ensure_elasticache_cluster",
        "ensure_internet_gateway",
        "ensure_route_table",
        "ensure_security_group",
        "ensure_db_subnet_group",
        "ensure_cache_subnet_group"
      ]
    },
    "extensions": {
      "allow_custom_actions": true
    },
    "capabilities": [
      "describe",
      "execute"
    ],
    "normalization": {
      "name_path": "name",
      "owner_path": "region",
      "external_id_path": "arn",
      "fallback_resource_prefix": "thirdparty.aws.custom"
    },
    "action_catalog": [
      {
        "name": "ensure_s3_bucket",
        "idempotent": true,
        "description": "Ensure one S3 bucket exists and optionally apply tags or versioning.",
        "resource_types": [
          "s3_bucket"
        ]
      },
      {
        "name": "ensure_ecr_repository",
        "idempotent": true,
        "description": "Ensure one ECR repository exists and optionally apply tags or scanning settings.",
        "resource_types": [
          "ecr_repository"
        ]
      },
      {
        "name": "upsert_secrets_manager_secret",
        "idempotent": true,
        "description": "Ensure one Secrets Manager secret exists and optionally write a new secret value.",
        "resource_types": [
          "secret"
        ]
      },
      {
        "name": "ensure_route53_zone",
        "idempotent": true,
        "description": "Ensure one Route53 hosted zone exists and optionally apply tags.",
        "resource_types": [
          "route53_zone"
        ]
      },
      {
        "name": "ensure_route53_record",
        "idempotent": true,
        "description": "Ensure one Route53 record exists in the target hosted zone.",
        "resource_types": [
          "route53_record"
        ]
      },
      {
        "name": "ensure_ses_identity",
        "idempotent": true,
        "description": "Ensure one SES email or domain identity exists.",
        "resource_types": [
          "ses_identity"
        ]
      },
      {
        "name": "send_email",
        "idempotent": false,
        "description": "Send one email through AWS SES.",
        "resource_types": [
          "email_message"
        ]
      },
      {
        "name": "send_sms",
        "idempotent": false,
        "description": "Send one SMS message through AWS SNS.",
        "resource_types": [
          "sms_message"
        ]
      },
      {
        "name": "ensure_iam_role",
        "idempotent": true,
        "description": "Ensure one IAM role exists with the desired trust policy and optionally inline policies.",
        "resource_types": [
          "iam_role"
        ]
      },
      {
        "name": "ensure_iam_policy_attachment",
        "idempotent": true,
        "description": "Ensure an IAM managed policy is attached to a role.",
        "resource_types": [
          "iam_policy_attachment"
        ]
      },
      {
        "name": "ensure_oidc_provider",
        "idempotent": true,
        "description": "Ensure an IAM OpenID Connect provider exists (used for IRSA and GitHub Actions federation).",
        "resource_types": [
          "oidc_provider"
        ]
      },
      {
        "name": "ensure_vpc",
        "idempotent": true,
        "description": "Ensure one VPC exists with the desired CIDR block, DNS attributes, and tags.",
        "resource_types": [
          "vpc"
        ]
      },
      {
        "name": "ensure_subnet",
        "idempotent": true,
        "description": "Ensure one subnet exists in the target VPC with the desired CIDR, AZ, and tags.",
        "resource_types": [
          "subnet"
        ]
      },
      {
        "name": "ensure_nat_gateway",
        "idempotent": true,
        "description": "Ensure one NAT Gateway exists in the target subnet (allocates an Elastic IP if not provided).",
        "resource_types": [
          "nat_gateway"
        ]
      },
      {
        "name": "ensure_eks_cluster",
        "idempotent": true,
        "description": "Ensure one EKS cluster exists with the desired Kubernetes version, VPC config, and control-plane logging.",
        "resource_types": [
          "eks_cluster"
        ]
      },
      {
        "name": "ensure_eks_nodegroup",
        "idempotent": true,
        "description": "Ensure one EKS managed node group exists with the desired instance types, disk size, and scaling config.",
        "resource_types": [
          "eks_nodegroup"
        ]
      },
      {
        "name": "ensure_rds_instance",
        "idempotent": true,
        "description": "Ensure one RDS database instance exists with the desired engine, instance class, storage, and VPC config.",
        "resource_types": [
          "rds_instance"
        ]
      },
      {
        "name": "ensure_elasticache_cluster",
        "idempotent": true,
        "description": "Ensure one ElastiCache cluster (Redis or Memcached) exists with the desired node type and VPC config.",
        "resource_types": [
          "elasticache_cluster"
        ]
      },
      {
        "name": "ensure_internet_gateway",
        "idempotent": true,
        "description": "Ensure an Internet Gateway exists and is attached to the target VPC.",
        "resource_types": [
          "internet_gateway"
        ]
      },
      {
        "name": "ensure_route_table",
        "idempotent": true,
        "description": "Ensure a route table exists with the desired routes and subnet associations.",
        "resource_types": [
          "route_table"
        ]
      },
      {
        "name": "ensure_security_group",
        "idempotent": true,
        "description": "Ensure a security group exists with the desired ingress rules.",
        "resource_types": [
          "security_group"
        ]
      },
      {
        "name": "ensure_db_subnet_group",
        "idempotent": true,
        "description": "Ensure an RDS DB subnet group exists spanning the given subnets.",
        "resource_types": [
          "db_subnet_group"
        ]
      },
      {
        "name": "ensure_cache_subnet_group",
        "idempotent": true,
        "description": "Ensure an ElastiCache subnet group exists spanning the given subnets.",
        "resource_types": [
          "cache_subnet_group"
        ]
      }
    ],
    "resource_types": [
      {
        "name": "s3_bucket",
        "discoverable": false,
        "default_actions": [
          "ensure_s3_bucket"
        ],
        "canonical_prefix": "thirdparty.aws.s3.bucket",
        "identity_template": "s3_bucket.{region}.{bucket_name}"
      },
      {
        "name": "ecr_repository",
        "discoverable": false,
        "default_actions": [
          "ensure_ecr_repository"
        ],
        "canonical_prefix": "thirdparty.aws.ecr.repository",
        "identity_template": "ecr_repository.{region}.{repository_name}"
      },
      {
        "name": "secret",
        "discoverable": false,
        "default_actions": [
          "upsert_secrets_manager_secret"
        ],
        "canonical_prefix": "thirdparty.aws.secrets_manager.secret",
        "identity_template": "secret.{region}.{secret_name}"
      },
      {
        "name": "route53_zone",
        "discoverable": false,
        "default_actions": [
          "ensure_route53_zone"
        ],
        "canonical_prefix": "thirdparty.aws.route53.hosted_zone",
        "identity_template": "route53_zone.{zone_name}"
      },
      {
        "name": "route53_record",
        "discoverable": false,
        "default_actions": [
          "ensure_route53_record"
        ],
        "canonical_prefix": "thirdparty.aws.route53.record",
        "identity_template": "route53_record.{zone_id}.{record_name}.{record_type}"
      },
      {
        "name": "ses_identity",
        "discoverable": false,
        "default_actions": [
          "ensure_ses_identity"
        ],
        "canonical_prefix": "thirdparty.aws.ses.identity",
        "identity_template": "ses_identity.{identity}"
      },
      {
        "name": "email_message",
        "discoverable": false,
        "default_actions": [
          "send_email"
        ],
        "canonical_prefix": "thirdparty.aws.ses.email",
        "identity_template": "email.{region}.{from_email}.{subject}"
      },
      {
        "name": "sms_message",
        "discoverable": false,
        "default_actions": [
          "send_sms"
        ],
        "canonical_prefix": "thirdparty.aws.sns.sms",
        "identity_template": "sms.{region}.{phone_number}"
      },
      {
        "name": "iam_role",
        "discoverable": false,
        "default_actions": [
          "ensure_iam_role"
        ],
        "canonical_prefix": "thirdparty.aws.iam.role",
        "identity_template": "iam_role.{role_name}"
      },
      {
        "name": "iam_policy_attachment",
        "discoverable": false,
        "default_actions": [
          "ensure_iam_policy_attachment"
        ],
        "canonical_prefix": "thirdparty.aws.iam.policy_attachment",
        "identity_template": "iam_policy_attachment.{role_name}.{policy_arn}"
      },
      {
        "name": "oidc_provider",
        "discoverable": false,
        "default_actions": [
          "ensure_oidc_provider"
        ],
        "canonical_prefix": "thirdparty.aws.iam.oidc_provider",
        "identity_template": "oidc_provider.{url}"
      },
      {
        "name": "vpc",
        "discoverable": false,
        "default_actions": [
          "ensure_vpc"
        ],
        "canonical_prefix": "thirdparty.aws.ec2.vpc",
        "identity_template": "vpc.{region}.{vpc_name}"
      },
      {
        "name": "subnet",
        "discoverable": false,
        "default_actions": [
          "ensure_subnet"
        ],
        "canonical_prefix": "thirdparty.aws.ec2.subnet",
        "identity_template": "subnet.{region}.{vpc_id}.{cidr_block}"
      },
      {
        "name": "nat_gateway",
        "discoverable": false,
        "default_actions": [
          "ensure_nat_gateway"
        ],
        "canonical_prefix": "thirdparty.aws.ec2.nat_gateway",
        "identity_template": "nat_gateway.{region}.{subnet_id}"
      },
      {
        "name": "eks_cluster",
        "discoverable": false,
        "default_actions": [
          "ensure_eks_cluster"
        ],
        "canonical_prefix": "thirdparty.aws.eks.cluster",
        "identity_template": "eks_cluster.{region}.{cluster_name}"
      },
      {
        "name": "eks_nodegroup",
        "discoverable": false,
        "default_actions": [
          "ensure_eks_nodegroup"
        ],
        "canonical_prefix": "thirdparty.aws.eks.nodegroup",
        "identity_template": "eks_nodegroup.{region}.{cluster_name}.{nodegroup_name}"
      },
      {
        "name": "rds_instance",
        "discoverable": false,
        "default_actions": [
          "ensure_rds_instance"
        ],
        "canonical_prefix": "thirdparty.aws.rds.instance",
        "identity_template": "rds_instance.{region}.{db_instance_identifier}"
      },
      {
        "name": "elasticache_cluster",
        "discoverable": false,
        "default_actions": [
          "ensure_elasticache_cluster"
        ],
        "canonical_prefix": "thirdparty.aws.elasticache.cluster",
        "identity_template": "elasticache_cluster.{region}.{cache_cluster_id}"
      },
      {
        "name": "internet_gateway",
        "discoverable": false,
        "default_actions": [
          "ensure_internet_gateway"
        ],
        "canonical_prefix": "thirdparty.aws.ec2.internet_gateway",
        "identity_template": "internet_gateway.{region}.{vpc_id}"
      },
      {
        "name": "route_table",
        "discoverable": false,
        "default_actions": [
          "ensure_route_table"
        ],
        "canonical_prefix": "thirdparty.aws.ec2.route_table",
        "identity_template": "route_table.{region}.{vpc_id}.{route_table_name}"
      },
      {
        "name": "security_group",
        "discoverable": false,
        "default_actions": [
          "ensure_security_group"
        ],
        "canonical_prefix": "thirdparty.aws.ec2.security_group",
        "identity_template": "security_group.{region}.{vpc_id}.{group_name}"
      },
      {
        "name": "db_subnet_group",
        "discoverable": false,
        "default_actions": [
          "ensure_db_subnet_group"
        ],
        "canonical_prefix": "thirdparty.aws.rds.db_subnet_group",
        "identity_template": "db_subnet_group.{region}.{name}"
      },
      {
        "name": "cache_subnet_group",
        "discoverable": false,
        "default_actions": [
          "ensure_cache_subnet_group"
        ],
        "canonical_prefix": "thirdparty.aws.elasticache.subnet_group",
        "identity_template": "cache_subnet_group.{region}.{name}"
      }
    ],
    "instance_schema": {
      "mode": "inline",
      "properties": {
        "base_url": {
          "type": "string",
          "description": "HTTP adapter base URL used when the integration_type declares transport=http_json."
        },
        "default_tags": {
          "type": "object",
          "description": "Default tags applied when an operation omits tags."
        },
        "default_region": {
          "type": "string",
          "default": "us-east-1",
          "description": "Default AWS region for governance operations."
        },
        "default_sms_type": {
          "type": "string",
          "default": "Transactional",
          "description": "Optional default SNS SMS type."
        },
        "default_account_id": {
          "type": "string",
          "description": "Optional fallback AWS account identifier used for metadata and normalization."
        },
        "default_email_from": {
          "type": "string",
          "description": "Optional default sender address for SES email operations."
        }
      }
    },
    "guardian_support": {
      "mode": "light",
      "signals": {
        "error_rate": [
          "error_rate",
          "failure_rate"
        ],
        "idle_hours": [
          "idle_hours",
          "last_active_hours_ago"
        ],
        "auth_denied": [
          "auth_denied",
          "unauthorized",
          "forbidden"
        ],
        "utilization": [
          "utilization",
          "avg_utilization"
        ],
        "rate_limited": [
          "rate_limited",
          "throttled",
          "quota_exceeded"
        ],
        "overprovisioned": [
          "overprovisioned"
        ],
        "monthly_cost_usd": [
          "monthly_cost_usd",
          "estimated_monthly_cost_usd",
          "cost_usd"
        ],
        "sync_lag_seconds": [
          "sync_lag_seconds",
          "reconciliation_lag_seconds"
        ]
      }
    },
    "credential_schema": {
      "mode": "inline",
      "properties": {
        "profile": {
          "type": "string",
          "description": "Optional shared config profile name when the worker should use local AWS profiles."
        },
        "access_key_id": {
          "type": "string",
          "secret": true,
          "description": "AWS access key id used by governance operations."
        },
        "session_token": {
          "type": "string",
          "secret": true,
          "description": "Optional AWS session token for temporary credentials."
        },
        "secret_access_key": {
          "type": "string",
          "secret": true,
          "description": "AWS secret access key used by governance operations."
        }
      }
    }
  }
}

{
  "apiVersion": "yggdrasil.io/v1alpha1",
  "kind": "integration_type",
  "metadata": {
    "name": "secrets-management-gcp-secret-manager",
    "namespace": "global",
    "labels": {
      "bootstrap_source": "secrets-management-gcp-secret-manager",
      "provider": "secrets-management"
    }
  },
  "spec": {
    "provider": "secrets-management",
    "family_ref": {
      "namespace": "global",
      "name": "secrets-management"
    },
    "implemented_operations": [
      "upsert_secret",
      "rotate_secret",
      "describe_secret",
      "read_secret",
      "delete_secret"
    ],
    "adapter": {
      "transport": "rabbitmq",
      "version": "1.0.0",
      "queues": {
        "describe": "yggdrasil.adapter.gcp-secret-manager.describe",
        "execute": "yggdrasil.adapter.gcp-secret-manager.execute"
      },
      "timeout_seconds": 60
    },
    "capabilities": [
      "describe",
      "execute"
    ],
    "credential_schema": {
      "mode": "none"
    },
    "instance_schema": {
      "mode": "inline",
      "properties": {
        "default_project_id": {
          "type": "string",
          "description": "GCP project ID used when BackendTarget.config.project_id is empty."
        },
        "default_replication_policy": {
          "type": "string",
          "default": "automatic"
        }
      }
    },
    "discovery": {
      "mode": "push",
      "cursor": "none"
    },
    "normalization": {
      "external_id_path": "secret_id",
      "name_path": "secret_id",
      "owner_path": "secret_id",
      "fallback_resource_prefix": "thirdparty.secrets-management.custom"
    },
    "execution": {
      "supports_dry_run": false,
      "idempotent_actions": [
        "upsert_secret",
        "describe_secret"
      ]
    },
    "extensions": {},
    "resource_types": [
      {
        "name": "secret",
        "canonical_prefix": "thirdparty.secrets-management.secret",
        "identity_template": "secret.{secret_id}",
        "discoverable": false,
        "default_actions": [
          "upsert_secret",
          "rotate_secret",
          "describe_secret",
          "read_secret",
          "delete_secret"
        ]
      }
    ],
    "action_catalog": [
      {
        "name": "upsert_secret",
        "description": "Create the secret if absent then add a new version.",
        "resource_types": [
          "secret"
        ],
        "idempotent": true
      },
      {
        "name": "rotate_secret",
        "description": "Add a new secret version with fresh value.",
        "resource_types": [
          "secret"
        ],
        "idempotent": false
      },
      {
        "name": "describe_secret",
        "description": "Return secret resource metadata.",
        "resource_types": [
          "secret"
        ],
        "idempotent": true
      },
      {
        "name": "read_secret",
        "description": "Access a version (default: latest). SENSITIVE.",
        "resource_types": [
          "secret"
        ],
        "idempotent": true
      },
      {
        "name": "delete_secret",
        "description": "Permanently delete the secret resource and all its versions.",
        "resource_types": [
          "secret"
        ],
        "idempotent": false
      }
    ]
  }
}

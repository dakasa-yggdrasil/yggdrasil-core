{
  "apiVersion": "yggdrasil.io/v1alpha1",
  "kind": "integration_instance",
  "metadata": {
    "name": "kubernetes-platform-prod",
    "namespace": "global",
    "description": "Default Kubernetes target integration instance used by product installations.",
    "labels": {
      "bootstrap_source": "integration-kubernetes",
      "provider": "kubernetes"
    }
  },
  "spec": {
    "type_ref": {
      "name": "kubernetes",
      "namespace": "global"
    },
    "status": "active",
    "owners": [
      "team:platform"
    ],
    "config": {
      "kubeconfig_path": "/etc/yggdrasil/kubeconfigs/platform-prod",
      "context": "platform-prod",
      "default_namespace": "default",
      "field_manager": "yggdrasil"
    },
    "discovery": {
      "enabled": false,
      "mode": "manual"
    },
    "execution": {
      "default_dry_run": false,
      "max_batch_size": 100
    }
  }
}

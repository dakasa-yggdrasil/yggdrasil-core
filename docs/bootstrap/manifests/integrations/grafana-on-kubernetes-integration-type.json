{
  "apiVersion": "yggdrasil.io/v1alpha1",
  "kind": "integration_type",
  "metadata": {
    "name": "grafana-on-kubernetes",
    "namespace": "global",
    "description": "Bootstrap integration type for the Grafana on Kubernetes installation plugin.",
    "labels": {
      "bootstrap_source": "integration-grafana-on-kubernetes",
      "provider": "grafana",
      "yggdrasil.io/catalog-domain": "grafana",
      "yggdrasil.io/catalog-section": "installations",
      "yggdrasil.io/catalog-entry": "kubernetes"
    }
  },
  "spec": {
    "provider": "grafana",
    "adapter": {
      "transport": "rabbitmq",
      "version": "1.0.0",
      "queues": {
        "describe": "yggdrasil.adapter.grafana-on-kubernetes.describe",
        "execute": "yggdrasil.adapter.grafana-on-kubernetes.execute"
      },
      "timeout_seconds": 20
    },
    "capabilities": [
      "describe",
      "execute"
    ],
    "guardian_support": {
      "mode": "light",
      "signals": {
        "oom_killed": ["oom_killed", "oom"],
        "restart_count": ["restart_count", "restarts"],
        "error_rate": ["error_rate", "failure_rate"],
        "memory_pressure": ["memory_pressure"],
        "disk_pressure": ["disk_pressure"],
        "sync_lag_seconds": ["sync_lag_seconds", "reconciliation_lag_seconds"]
      }
    },
    "credential_schema": {
      "mode": "none"
    },
    "instance_schema": {
      "mode": "inline",
      "properties": {
        "default_blueprint": {
          "type": "string",
          "description": "Default generation blueprint when the product input omits one.",
          "default": "single-instance"
        },
        "default_name": {
          "type": "string",
          "description": "Default Grafana deployment name.",
          "default": "grafana"
        },
        "default_namespace": {
          "type": "string",
          "description": "Default namespace for generated Grafana resources.",
          "default": "grafana"
        },
        "default_image": {
          "type": "string",
          "description": "Default Grafana image used by the generated deployment.",
          "default": "grafana/grafana:11.1.0"
        },
        "default_service_type": {
          "type": "string",
          "description": "Default Kubernetes Service type exposed by Grafana.",
          "default": "ClusterIP"
        },
        "default_port": {
          "type": "integer",
          "description": "Grafana HTTP port used by the container and service.",
          "default": 3000
        },
        "default_storage": {
          "type": "string",
          "description": "Default persistent volume size for Grafana storage.",
          "default": "10Gi"
        },
        "persistence_enabled": {
          "type": "boolean",
          "description": "Controls whether generated Grafana instances include a PVC.",
          "default": true
        },
        "default_admin_user": {
          "type": "string",
          "description": "Default Grafana admin username.",
          "default": "admin"
        },
        "default_admin_password": {
          "type": "string",
          "description": "Default Grafana admin password.",
          "default": "grafana-admin-change-me",
          "secret": true
        },
        "default_admin_secret_name": {
          "type": "string",
          "description": "Default secret name for Grafana admin credentials.",
          "default": "grafana-admin-credentials"
        },
        "default_ingress_host": {
          "type": "string",
          "description": "Optional default host for generated ingress resources."
        },
        "default_ingress_class_name": {
          "type": "string",
          "description": "Optional default ingress class name."
        }
      }
    },
    "resource_types": [
      {
        "name": "instance",
        "canonical_prefix": "thirdparty.grafana.instance",
        "identity_template": "instance.{namespace}.{name}",
        "discoverable": false,
        "default_actions": [
          "generate_installation",
          "reconcile_installation",
          "discover_installation_state"
        ]
      }
    ],
    "action_catalog": [
      {
        "name": "generate_installation",
        "description": "Generate a Grafana installation component as raw Kubernetes objects.",
        "resource_types": [
          "instance"
        ],
        "idempotent": true
      },
      {
        "name": "reconcile_installation",
        "description": "Build a declarative reconciliation plan for a Grafana installation.",
        "resource_types": [
          "instance"
        ],
        "idempotent": true
      },
      {
        "name": "discover_installation_state",
        "description": "Return the currently known installation state for a Grafana blueprint.",
        "resource_types": [
          "instance"
        ],
        "idempotent": true
      }
    ],
    "discovery": {
      "mode": "push",
      "cursor": "none"
    },
    "normalization": {
      "external_id_path": "metadata.name",
      "name_path": "metadata.name",
      "owner_path": "metadata.namespace",
      "fallback_resource_prefix": "thirdparty.grafana.custom"
    },
    "execution": {
      "supports_dry_run": false,
      "idempotent_actions": [
        "generate_installation",
        "reconcile_installation",
        "discover_installation_state"
      ]
    },
    "extensions": {}
  }
}

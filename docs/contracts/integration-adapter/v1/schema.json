{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yggdrasil.io/contracts/integration-adapter/v1/schema.json",
  "title": "Yggdrasil Integration Adapter v1",
  "type": "object",
  "description": "Bundle schema for the generic adapter describe/execute protocol.",
  "$defs": {
    "manifestSelector": {
      "type": "object",
      "properties": {
        "manifest_id": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "manifestReference": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "namespace",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "integrationAdapterQueue": {
      "type": "object",
      "properties": {
        "describe": {
          "type": "string"
        },
        "discover": {
          "type": "string"
        },
        "read": {
          "type": "string"
        },
        "execute": {
          "type": "string"
        },
        "sync": {
          "type": "string"
        },
        "health": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "integrationAdapterRoute": {
      "type": "object",
      "properties": {
        "describe": {
          "type": "string"
        },
        "discover": {
          "type": "string"
        },
        "read": {
          "type": "string"
        },
        "execute": {
          "type": "string"
        },
        "sync": {
          "type": "string"
        },
        "health": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "integrationAdapterSpec": {
      "type": "object",
      "required": [
        "transport",
        "version"
      ],
      "properties": {
        "transport": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "queues": {
          "$ref": "#/$defs/integrationAdapterQueue"
        },
        "endpoints": {
          "$ref": "#/$defs/integrationAdapterRoute"
        },
        "timeout_seconds": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "integrationSchemaProperty": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "secret": {
          "type": "boolean"
        },
        "enum": {
          "type": "array",
          "items": true
        },
        "default": true
      }
    },
    "integrationSchemaSpec": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/integrationSchemaProperty"
          }
        }
      }
    },
    "integrationCredentialPolicySpec": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "materialize_inline": {
          "type": "boolean"
        }
      }
    },
    "integrationGuardianSignalSupportSpec": {
      "type": "object",
      "properties": {
        "oom_killed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "restart_count": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error_rate": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "queue_backlog": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "memory_pressure": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disk_pressure": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rate_limited": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auth_denied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sync_lag_seconds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "monthly_cost_usd": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "utilization": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "idle_hours": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overprovisioned": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scheduling_failure": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "insufficient_cpu": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "integrationGuardianSupportSpec": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        },
        "signals": {
          "$ref": "#/$defs/integrationGuardianSignalSupportSpec"
        }
      }
    },
    "integrationResourceType": {
      "type": "object",
      "required": [
        "name",
        "canonical_prefix",
        "identity_template",
        "discoverable",
        "default_actions"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "canonical_prefix": {
          "type": "string"
        },
        "identity_template": {
          "type": "string"
        },
        "discoverable": {
          "type": "boolean"
        },
        "default_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "integrationActionDefinition": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "resource_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "idempotent": {
          "type": "boolean"
        },
        "category": {
          "type": "string",
          "enum": ["", "reactor", "capability", "permission"],
          "description": "Categoria semântica: reactor (hook interno, oculto em pickers), capability (operação dispatched), permission (granted via team_grant, autorizada downstream). Vazio = capability (back-compat)."
        }
      }
    },
    "integrationDiscoverySpec": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "cursor": {
          "type": "string"
        },
        "supports_webhooks": {
          "type": "boolean"
        }
      }
    },
    "integrationNormalizationSpec": {
      "type": "object",
      "required": [
        "external_id_path",
        "fallback_resource_prefix"
      ],
      "properties": {
        "external_id_path": {
          "type": "string"
        },
        "name_path": {
          "type": "string"
        },
        "owner_path": {
          "type": "string"
        },
        "fallback_resource_prefix": {
          "type": "string"
        }
      }
    },
    "integrationExecutionSpec": {
      "type": "object",
      "properties": {
        "supports_dry_run": {
          "type": "boolean"
        },
        "idempotent_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "integrationExtensionsSpec": {
      "type": "object",
      "properties": {
        "allow_custom_resource_types": {
          "type": "boolean"
        },
        "allow_custom_actions": {
          "type": "boolean"
        },
        "preserve_raw_payload": {
          "type": "boolean"
        }
      }
    },
    "integrationTypeManifestSpec": {
      "type": "object",
      "required": [
        "provider",
        "adapter",
        "capabilities",
        "credential_schema",
        "instance_schema",
        "resource_types",
        "discovery",
        "normalization",
        "execution",
        "extensions"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "adapter": {
          "$ref": "#/$defs/integrationAdapterSpec"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "credential_policy": {
          "$ref": "#/$defs/integrationCredentialPolicySpec"
        },
        "guardian_support": {
          "$ref": "#/$defs/integrationGuardianSupportSpec"
        },
        "credential_schema": {
          "$ref": "#/$defs/integrationSchemaSpec"
        },
        "instance_schema": {
          "$ref": "#/$defs/integrationSchemaSpec"
        },
        "resource_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/integrationResourceType"
          }
        },
        "action_catalog": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/integrationActionDefinition"
          }
        },
        "discovery": {
          "$ref": "#/$defs/integrationDiscoverySpec"
        },
        "normalization": {
          "$ref": "#/$defs/integrationNormalizationSpec"
        },
        "execution": {
          "$ref": "#/$defs/integrationExecutionSpec"
        },
        "extensions": {
          "$ref": "#/$defs/integrationExtensionsSpec"
        }
      }
    },
    "integrationInstanceDiscoverySpec": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string"
        },
        "sync_interval_seconds": {
          "type": "integer"
        }
      }
    },
    "integrationInstanceExecutionSpec": {
      "type": "object",
      "properties": {
        "default_dry_run": {
          "type": "boolean"
        },
        "max_batch_size": {
          "type": "integer"
        }
      }
    },
    "integrationInstanceManifestSpec": {
      "type": "object",
      "required": [
        "type_ref",
        "discovery"
      ],
      "properties": {
        "type_ref": {
          "$ref": "#/$defs/manifestSelector"
        },
        "status": {
          "type": "string"
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "credentials": {
          "type": "object",
          "additionalProperties": true
        },
        "credentials_ref": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "additionalProperties": true
        },
        "discovery": {
          "$ref": "#/$defs/integrationInstanceDiscoverySpec"
        },
        "execution": {
          "$ref": "#/$defs/integrationInstanceExecutionSpec"
        }
      }
    },
    "adapterDescribeRequest": {
      "type": "object",
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "expected_version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "adapterDescribeResponse": {
      "type": "object",
      "required": [
        "provider",
        "adapter",
        "capabilities",
        "credential_schema",
        "instance_schema",
        "resource_types",
        "discovery",
        "normalization",
        "execution",
        "extensions"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "adapter": {
          "$ref": "#/$defs/integrationAdapterSpec"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "credential_schema": {
          "$ref": "#/$defs/integrationSchemaSpec"
        },
        "instance_schema": {
          "$ref": "#/$defs/integrationSchemaSpec"
        },
        "resource_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/integrationResourceType"
          }
        },
        "action_catalog": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/integrationActionDefinition"
          }
        },
        "discovery": {
          "$ref": "#/$defs/integrationDiscoverySpec"
        },
        "normalization": {
          "$ref": "#/$defs/integrationNormalizationSpec"
        },
        "execution": {
          "$ref": "#/$defs/integrationExecutionSpec"
        },
        "extensions": {
          "$ref": "#/$defs/integrationExtensionsSpec"
        }
      },
      "additionalProperties": false
    },
    "adapterExecuteIntegrationContext": {
      "type": "object",
      "required": [
        "type",
        "type_spec",
        "instance",
        "instance_spec"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/manifestReference"
        },
        "type_spec": {
          "$ref": "#/$defs/integrationTypeManifestSpec"
        },
        "instance": {
          "$ref": "#/$defs/manifestReference"
        },
        "instance_spec": {
          "$ref": "#/$defs/integrationInstanceManifestSpec"
        }
      },
      "additionalProperties": false
    },
    "adapterExecuteIntegrationRequest": {
      "type": "object",
      "required": [
        "operation",
        "integration"
      ],
      "properties": {
        "operation": {
          "type": "string"
        },
        "capability": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "additionalProperties": true
        },
        "auth": {
          "type": "object",
          "additionalProperties": true
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "integration": {
          "$ref": "#/$defs/adapterExecuteIntegrationContext"
        }
      },
      "additionalProperties": false
    },
    "adapterExecuteIntegrationResponse": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string"
        },
        "capability": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "output": true,
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}

[Unit]
Description=Owned network operational health and bounded terminal controller recovery
After=dakasa-capacity-network.service dakasa-capacity-network-hub.service dakasa-capacity-network-cold-transport.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/dakasa/capacity-network/network-boot-recovery-r13-g9pair-source-v1/network_guardian.py --watch --source-sha256 6defe12adc0cac920c767c09c49c25db589d9ec9a0dee5abc0f3cc03dfe18765
Restart=on-failure
RestartSec=15
TimeoutStopSec=5
KillMode=control-group
CPUQuota=25%
MemoryMax=384M
MemorySwapMax=0
TasksMax=32
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

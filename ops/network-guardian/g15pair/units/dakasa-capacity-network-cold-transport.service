[Unit]
Description=Cold restore the eight fixed bridge and MSS transport rules
After=network-online.target k3s.service
Wants=network-online.target
Requires=k3s.service
Before=dakasa-capacity-network-hub.service dakasa-capacity-network.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/dakasa/capacity-network/network-boot-recovery-r13-g15pair-source-v1/network_guardian.py --cold-restore --source-sha256 88afcd71d53b7f0f7f79bf1f8f0c4a31436e60cb9874c1ece77bfe3e835cc7b3
RemainAfterExit=yes
Restart=no
TimeoutStartSec=180
TimeoutStopSec=5
KillMode=control-group
CPUQuota=25%
MemoryMax=384M
MemorySwapMax=0
TasksMax=32
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
RequiredBy=dakasa-capacity-network-hub.service dakasa-capacity-network.service

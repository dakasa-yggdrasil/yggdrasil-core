[Unit]
Description=Owned network operational health and bounded terminal controller recovery
After=dakasa-capacity-network.service dakasa-capacity-network-hub.service dakasa-capacity-network-cold-transport.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/dakasa/capacity-network/network-boot-recovery-r13-g8pair-source-v1/network_guardian.py --watch --source-sha256 8259638127d811079d6a461d3bd7407f8a53ff3ebb75e8061bf8538dcf6508b9
Restart=on-failure
RestartSec=15
TimeoutStopSec=5
KillMode=control-group
CPUQuota=25%
MemoryMax=384M
MemorySwapMax=0
TasksMax=32
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
